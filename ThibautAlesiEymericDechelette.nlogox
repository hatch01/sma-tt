    <chooser x="20" y="190" height="60" variable="strategie" current="3" width="250" display="strategie">
      <choice type="string" value="max-idle"></choice>
      <choice type="string" value="random"></choice>
      <choice type="string" value="cognitif"></choice>
      <choice type="string" value="do nothing"></choice>
