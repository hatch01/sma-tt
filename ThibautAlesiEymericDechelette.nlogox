<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[globals [avg-idleness max-idleness max-max-idleness max-avg-idleness normalized-max-max-idleness normalized-max-avg-idleness]

breed [patrouilleurs patrouilleur] ; créer l'espece des patrouilleurs
patrouilleurs-own [id] ; ajouter l'attribut d'identitication a tout les patrouilleurs
patches-own [idleness] ; oisiveté

to setup 
  clear-all
  
  set-default-shape patrouilleurs "airplane" ; tout les patrouilleurs ont une forme d'avion
  create-patrouilleurs n-patrouille
  ask patrouilleurs [ 
    setxy 9.5 9.5 ; déplace le patrouilleur au "centre" comme c'est du 20x20 (0-19x0-19) 9.5x9.5 du coup
    set id who ; init l'id du patrouilleurs
    set label id ; affiche l'id attention le faire aprés l'init de l'id
  ]
  ask patches [ 
    set idleness 0
    set plabel idleness
  ]
  
  set max-max-idleness 0
  set max-avg-idleness 0
  set normalized-max-avg-idleness 0
  set normalized-max-max-idleness 0
  
  reset-ticks
end

to go
  one-step ; do one step in loop
end

to one-step
  if ticks >= max-step [ stop ] ; stop do nothing if we exceed the max steps
  go-patrouille ; move the patrouille
  update-patches
  tick ; increment the tick counter
end

to update-patches
  ask patches [
    set idleness idleness + 1
    set plabel idleness
  ]
  
  set avg-idleness mean [idleness] of patches
  set max-idleness max [idleness] of patches
  set max-max-idleness max (list max-max-idleness max-idleness)
  set max-avg-idleness max (list max-avg-idleness avg-idleness)
  set normalized-max-max-idleness (n-patrouille / count patches) * max-max-idleness
  set normalized-max-avg-idleness (n-patrouille / count patches) * max-avg-idleness
  
end


to go-patrouille
  ; ask patrouilleurs [ 
  (ifelse
    strategie = "random" [ ask patrouilleurs [
      move-to one-of neighbors4
      reset
    ] ]
    strategie = "max-idle" [ask patrouilleurs [  
      move-to max-one-of neighbors4 [idleness] 
      reset
    ] ]
    strategie = "cognitif" [
      foreach shuffle sort patrouilleurs [
        patrouilleurCourant ->
        ask patrouilleurCourant [ strat-cog
          reset
        ]
      ]
    ]
    [ ]
  )
  ;] ; move all the patrouilleurs to the neighbours around them
end

to reset
  ask patch-here [
    set idleness 0
    set plabel idleness
  ]
end


to strat-cog
  let cible max-one-of patches [
    idleness - (abs (pxcor - [xcor] of myself) +
      abs (pycor - [ycor] of myself))
  ]
  
  let chemin (bfs-to cible)
  if not empty? chemin [
    move-to first chemin
  ]  


end


; PLUS COURT CHEMIN : PARCOURS EN LARGEUR (BFS)
to-report bfs-to [target]
  let start patch-here ; la tuile de départ = position actuelle du patrouilleur
  
  ; Aucun déplacement nécéssaire
  if target = start [
    report []
  ]
  
  let queue (list (list start)) ;on démarre avec un seul chemin, réduit à la tuile de départ
  let visited (list start) ; tuiles déjà visitées, pour ne jamais les explorer deux fois

  while [not empty? queue] [
    let path first queue ; on récupère le plus ancien chemin de la file (mode FIFO)
    set queue but-first queue ; on retire de la file

    let current-patch last path ; dernière tuile du chemin = tuile actuellement atteinte

    if current-patch = target [ ; Si on est arrivé à la cible, on a trouvé le plus court chemi
      ; on retire seulement la tuile de dpart
      report but-first path
    ]

    let adjacent-patches [neighbors4] of current-patch; On explore les 4 voisines de la tuile courante


    foreach sort adjacent-patches [
      next-patch ->

      if not member? next-patch visited [ ;On n'ajoute une voisine à explorer que si elle n'a pas déjà été visitée
        set visited lput next-patch visited 
        set queue lput (lput next-patch path) queue; on crée un nouveau chemin = l'ancien chemin + cette nouvelle tuile, et on l'ajoute à la fin de la file
      ]
    ]
  ]

  report [] ;permet de renvoyer une réponse si la file se vide sans atteindre de cible
end
]]></code>
